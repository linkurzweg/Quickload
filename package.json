{
  "name": "quickload",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.18.0 <13"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "node scripts/dev.mjs ui",
    "setup": "node scripts/dev.mjs setup",
    "doctor": "node scripts/dev.mjs doctor",
    "verify": "node scripts/dev.mjs verify",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1",
    "check": "node scripts/dev.mjs check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run",
    "test:e2e": "node scripts/dev.mjs e2e",
    "tauri": "tauri",
    "desktop": "node scripts/dev.mjs desktop",
    "desktop:build": "node scripts/dev.mjs build"
  },
  "dependencies": {
    "@lucide/svelte": "^1.70.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "svelte-check": "^4.4.0",
    "typescript": "^5.9.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
